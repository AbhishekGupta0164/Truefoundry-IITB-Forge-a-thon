{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "version": "0.1.0",
  "publisher": "truefoundry",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbhishekGupta0164/Truefoundry-IITB-Forge-a-thon"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.14"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forge.inlineEdit",
        "title": "Forge: Inline Edit"
      },
      {
        "command": "forge.openPanel",
        "title": "Forge: Open Agent Panel"
      },
      {
        "command": "forge.cancel",
        "title": "Forge: Cancel Run"
      },
      {
        "command": "forge.undoTask",
        "title": "Forge: Undo Whole Task"
      },
      {
        "command": "forge.copyMcpConfig",
        "title": "Forge: Copy MCP Connector Settings"
      },
      {
        "command": "forge.startAll",
        "title": "Forge: Start All"
      },
      {
        "command": "forge.stopAll",
        "title": "Forge: Stop All"
      },
      {
        "command": "forge.selfTest",
        "title": "Forge: Self-Test"
      }
    ],
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "properties": {
        "forge.mcpPort": {
          "type": "number",
          "default": 8765
        },
        "forge.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790"
        },
        "forge.trueforgeVersion": {
          "type": "string",
          "default": "0.184.3",
          "description": "Pinned TrueForge version used across all teammates and environments"
        },
        "forge.model": {
          "type": "string",
          "default": "ollama/llama-3-2-3b",
          "description": "TrueForge primary model identifier (pinned 7B-14B coding model)"
        },
        "forge.fallbackModel": {
          "type": "string",
          "default": "ollama/llama-3-2-3b",
          "description": "TrueForge secondary fallback model used if primary model fails after retries"
        },
        "forge.temperature": {
          "type": "number",
          "default": 0,
          "description": "Model sampling temperature (must be 0 for deterministic code generation)"
        },
        "forge.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start TrueForge when the extension activates."
        },
        "forge.trueforgeDataDir": {
          "type": "string",
          "default": "",
          "description": "Optional: custom path to TrueForge data directory (leave blank for default ~/.trueforge)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test:unit": "vitest run",
    "test:e2e": "vscode-test",
    "eval": "tsx eval/run.ts",
    "start:all": "node scripts/start-all.mjs",
    "package": "vsce package --no-dependencies",
    "vsce-package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@truefoundry/trueforge-sdk": "^0.184.1",
    "diff": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "vitest": "^1.6.0"
  }
}
